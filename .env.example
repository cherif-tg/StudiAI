# --- API ---
API_KEYS=dev-key                # clés acceptées (séparées par des virgules), header X-API-Key
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- LLM principal (Groq, utilisé par l'agent : function calling fiable + latence très basse) ---
LLM_PROVIDER=groq               # groq | ollama (voir docker-compose.yml et README)
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_MODEL=llama-3.3-70b-versatile

# --- LLM local optionnel (Ollama, pour dev hors-ligne / tâches sans function calling) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Recherche web (optionnel, Tavily) ---
TAVILY_API_KEY=

# --- RAG ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Traduction langues locales ---
# disabled | local (NLLB + adaptateur LoRA dans le même processus) | remote (service HTTP séparé, ex. HF Space)
TRANSLATION_MODE=disabled
TRANSLATION_BASE_MODEL=facebook/nllb-200-distilled-600M
TRANSLATION_ADAPTER_PATH=
TRANSLATION_REMOTE_URL=
