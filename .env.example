# URL publique de l'API, sans slash final.
#   vide                      -> même origine : FastAPI sert l'interface (tout-en-un)
#   https://api.exemple.tg    -> interface hébergée ailleurs (Vercel, Netlify…)
VITE_API_BASE_URL=

# Développement uniquement : backend vers lequel « npm run dev » relaie l'API.
# VITE_DEV_API_TARGET=http://127.0.0.1:8000

# Contact et mentions de l'instance (pages juridiques, footer).
#   VITE_CONTACT_ENDPOINT : URL qui reçoit le formulaire en POST JSON {email, message, page}
#                           (service de formulaires ou route de ton backend). Prioritaire.
#   VITE_CONTACT_EMAIL    : sinon, le formulaire ouvre la messagerie vers cette adresse.
VITE_CONTACT_ENDPOINT=
VITE_CONTACT_EMAIL=
VITE_EDITEUR_NOM=
VITE_HEBERGEUR_NOM=
