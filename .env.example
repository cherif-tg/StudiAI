# --- API ---
API_KEYS=dev-key                # clés acceptées (séparées par des virgules), header X-API-Key
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- LLM principal (Groq, utilisé par l'agent : function calling fiable + latence très basse) ---
LLM_PROVIDER=groq               # groq | ollama (voir docker-compose.yml et README)
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_MODEL=llama-3.3-70b-versatile

# --- LLM local optionnel (Ollama, pour dev hors-ligne / tâches sans function calling) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Recherche web (optionnel, Tavily) ---
TAVILY_API_KEY=

# --- RAG ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Traduction langues locales ---
# disabled | local (NLLB + adaptateur LoRA dans le même processus) | remote (service HTTP séparé, ex. HF Space)
TRANSLATION_MODE=disabled
TRANSLATION_BASE_MODEL=facebook/nllb-200-distilled-600M
TRANSLATION_ADAPTER_PATH=
TRANSLATION_REMOTE_URL=

# --- Garde-fous d'exposition publique (tunnel cloudflared, VPS) ---
# Taille maximale par fichier déposé, en Mo.
MAX_UPLOAD_MB=20
# Plafond du dossier d'uploads, en Mo : au-delà, les dépôts sont refusés.
MAX_STORAGE_MB=500
# Fenêtre glissante sur /chat (nombre de questions par fenêtre, en secondes).
CHAT_RATE_LIMIT=30
CHAT_RATE_WINDOW_S=600
# Mettre à true derrière cloudflared ou Caddy pour récupérer l'adresse réelle.
TRUST_PROXY_HEADERS=true

# --- Déploiement séparé (interface sur Vercel, API ailleurs) ---
# Origines autorisées, séparées par des virgules. Jamais * : le cookie de
# session exige des origines explicites.
# CORS_ORIGINS=https://app.exemple.tg,https://nunya.vercel.app
# lax  : interface et API sur le même domaine (app./api.) — recommandé
# none : deux domaines différents (HTTPS obligatoire, cookies tiers souvent bloqués)
COOKIE_SAMESITE=lax

# --- Droits sur les données, mot de passe, contact ---
# Adresse publique de l'interface : sert à construire le lien de réinitialisation.
APP_PUBLIC_URL=http://127.0.0.1:8000
# Envoi d'e-mails. Sans SMTP_HOST, le message est écrit dans le journal (dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Adresse qui reçoit les messages du formulaire de contact.
CONTACT_DESTINATAIRE=
